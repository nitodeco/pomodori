{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pomodori",
  "version": "0.1.0",
  "identifier": "com.nitodeco.pomodori",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    },
    "windows": [
      {
        "label": "main",
        "title": "Pomodori",
        "width": 320,
        "height": 400,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Settings",
        "width": 360,
        "height": 520,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "visible": false,
        "url": "settings-window.html"
      },
      {
        "label": "stats",
        "title": "Statistics",
        "width": 320,
        "height": 280,
        "resizable": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "shadow": true,
        "visible": false,
        "url": "stats-window.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
