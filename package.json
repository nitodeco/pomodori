  "devDependencies": {
    "@biomejs/biome": "2.3.13",
    "@stylistic/eslint-plugin": "5.7.1",
    "@tauri-apps/cli": "2.9.6",
    "eslint": "9.39.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vite": "7.3.1"
  }
}
